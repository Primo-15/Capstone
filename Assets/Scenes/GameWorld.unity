  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  interactDistance: 2
  promptUI: {fileID: 257303236}
  promptText: {fileID: 257303238}
  promptMessage: Press "E" to talk to manang
  dialoguePanel: {fileID: 432283908}
  dialogueText: {fileID: 1695427484}
  notReadyLines:
  - Isay, I'm busy right now.
  - Why don't you go talk to your mom first?
  dialogueLines:
  - Oh thank you Isay
  - Can you help me with something?
  - I need you to gather 5 <b><color=red>apples</color></b> for our visitors later
  reminderLines:
  - Please gather me 5 <b><color=red>apples</color></b>, Isay.
  completeLines:
  - Thanks Isay!
  - You have such a good heart
  - By the way here's a sinigang as a thanks
  - You can bring the sinigang to your mom
  afterLines:
  - Bring the sinigang to your mom.
